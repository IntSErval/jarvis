# Copy this file to .env and fill in real values. .env is gitignored — never
# put real secrets in THIS file (.env.example is committed to git).

# --- Supabase (audit log store) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# --- Model (Phase 1: direct Anthropic call; OmniRoute gateway added in Phase 2) ---
ANTHROPIC_API_KEY=
# --- Google Calendar (read-only: calendar.readonly scope only) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional — calendar to read; defaults to the account's primary calendar.
GOOGLE_CALENDAR_ID=
# Opt-in: reuses the Google OAuth creds above, but needs gmail.readonly scope
# on the refresh token. Set to a truthy value to enable read-only Gmail tools.
GMAIL_ENABLED=
# --- GitHub (read-only: fine-grained PAT with read-only Contents/Issues) ---
GITHUB_TOKEN=
# Optional — default repo owner/name; tool args may override per call.
GITHUB_OWNER=
GITHUB_REPO=
# --- Notion (read-only: integration token with read-only capabilities) ---
NOTION_TOKEN=
# --- Semantic memory embeddings (optional) ---
# Free Google AI Studio key for real semantic recall (gemini-embedding-001).
# Absent => the deterministic localEmbedder (lexical only) is used. The pgvector
# memory store itself activates on the Supabase creds above.
GOOGLE_AI_API_KEY=
# --- Routines (Phase 3, optional) ---
# Path to a JSON array of { id, schedule (5-field cron), prompt, channel? }.
# Absent => no scheduler runs (deny-by-default, $0). e.g. routines.json
ROUTINES_FILE=
# --- WhatsApp gateway (Phase 3, optional) ---
# All four required to mount /webhook/whatsapp; absent => the routes 404.
# From the Meta WhatsApp Cloud API app. APP_SECRET signs inbound webhooks (HMAC).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional — your own number; routines with channel "whatsapp" deliver here.
WHATSAPP_SELF=
# --- Worker ---
PORT=3000
