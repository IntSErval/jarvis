# Copy this file to .env and fill in real values. .env is gitignored — never
# put real secrets in THIS file (.env.example is committed to git).

# --- Supabase (audit log store) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# --- Model (Phase 1: direct Anthropic call; OmniRoute gateway added in Phase 2) ---
ANTHROPIC_API_KEY=
# --- Google Calendar (read-only: calendar.readonly scope only) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional — calendar to read; defaults to the account's primary calendar.
GOOGLE_CALENDAR_ID=
# --- Worker ---
PORT=3000
